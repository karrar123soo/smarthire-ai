# ==========================================
# SmartHire AI - Root .gitignore
# ==========================================

# Compiled class files
*.class

# Log files
*.log
logs/
*.log.*

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build artifacts
target/
backend/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Node / Frontend dependencies and builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secret Files
.env
.env*.local
*.env
!.env.example

# IDE & Editor Configs
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# File Uploads / Local Media Storage
uploads/
backend/uploads/

# Tooling / AI Agent cache
.gemini/
.system_generated/
