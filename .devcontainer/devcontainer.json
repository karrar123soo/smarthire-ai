{
  "name": "SmartHire AI Codespace",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "5173": {
      "label": "SmartHire AI Frontend Portal",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "Spring Boot Backend API",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "cd backend && mvn clean package -DskipTests && cd ../frontend && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
